{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/session-setup.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(just bootstrap)",
      "Bash(just check)",
      "Bash(just test)",
      "Bash(just test-e2e)",
      "Bash(just lint)",
      "Bash(just format)",
      "Bash(just format-check)",
      "Bash(just upgrade)",
      "Bash(just release)",
      "Bash(just setup-llmlint)",
      "Bash(just lint-llm-diff:*)",
      "Bash(just lint-llm-validate:*)",
      "Bash(just msrv)",
      "Bash(just supply-chain)",
      "Bash(just coverage)",
      "Bash(just lint all)",
      "Bash(just test all)",
      "Bash(just check all)",
      "Bash(just bench)",
      "Bash(just bench-allocs)",
      "Bash(just bench-cli)",
      "Bash(just bench-cli-smoke)",
      "Bash(just bench-instructions)",
      "Bash(just bench-all)",
      "Bash(cargo bench:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo nextest:*)",
      "Bash(cargo run:*)",
      "Bash(cargo update:*)",
      "Bash(cargo fetch:*)",
      "Bash(cargo check:*)",
      "Bash(rustup component add:*)",
      "Bash(uv run:*)",
      "Bash(bash scripts/nx:*)",
      "Bash(bun test:*)",
      "Bash(actionlint:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": []
  }
}
